# ==========================================
# ONE UNUSU - Unified Environment Configuration
# ==========================================

# Backend API Configuration
PORT=5000
DATABASE_URL="mysql://root:@localhost:3306/one_unusu_db"
CORS_ORIGIN="http://localhost:5173"

# Frontend Vite Configuration
VITE_API_URL="http://localhost:5000/api"

# --- Secret sesi JWT (WAJIB; server menolak start bila kosong) ---
# Buat dengan: openssl rand -hex 32
JWT_SECRET="<generate-with-openssl-rand-hex-32>"

# --- Client key SSO per aplikasi (WAJIB untuk prisma:seed) ---
# Buat masing-masing dengan: openssl rand -hex 24
# Nilai yang sama harus dipasang di .env aplikasi klien sebagai SSO_CLIENT_KEY.
SSO_CLIENT_KEY_LMS_UNUSU="<client-key-lms-unusu>"
SSO_CLIENT_KEY_LPPM_UNUSU="<client-key-lppm-unusu>"
SSO_CLIENT_KEY_LPM_UNUSU="<client-key-lpm-unusu>"
SSO_CLIENT_KEY_ESURAT_UNUSU="<client-key-esurat-unusu>"
SSO_CLIENT_KEY_SDM_SARPRAS="<client-key-sdm-sarpras>"
SSO_CLIENT_KEY_UNUSU_LMS="<client-key-unusu-lms>"
SSO_CLIENT_KEY_UNUSU_AKREDITASI="<client-key-unusu-akreditasi>"
