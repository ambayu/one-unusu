{
  "name": "one-unusu",
  "version": "1.0.0",
  "description": "ONE UNUSU - Integrated Digital Campus (Single Package Fullstack Monolith)",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch src/server/index.ts\" \"vite\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:local": "cross-env SEED_TARGET=local tsx prisma/seed.ts",
    "db:seed:vps": "cross-env SEED_TARGET=vps tsx prisma/seed.ts",
    "db:sso-dev-urls": "tsx prisma/dev-sso-urls.ts",
    "db:sso-vps-urls": "tsx prisma/vps-sso-urls.ts",
    "prisma:seed": "npm run db:seed",
    "prisma:seed:local": "npm run db:seed:local",
    "prisma:seed:vps": "npm run db:seed:vps",
    "prisma:sso-dev-urls": "npm run db:sso-dev-urls",
    "prisma:sso-vps-urls": "npm run db:sso-vps-urls",
    "db:preflight": "tsx scripts/db/preflight-migration.ts",
    "db:parity": "tsx scripts/db/verify-migration-parity.ts",
    "db:backup": "tsx scripts/db/backup-database.ts",
    "db:verify:post": "tsx scripts/db/verify-post-migration.ts",
    "db:cleanup:tokens": "tsx scripts/db/cleanup-sso-tokens.ts",
    "db:purge:audit": "tsx scripts/db/purge-audit-logs.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.5",
    "postcss": "^8.4.47",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^6.4.5"
  }
}
