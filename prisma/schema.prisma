// Prisma schema for ONE UNUSU - Central SSO Identity Provider & Portal Gateway
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. MASTER PENGGUNA SSO
model User {
  id             Int        @id @default(autoincrement())
  username       String     @unique // NIM Mahasiswa / NIDN Dosen / Username Admin
  password       String // Hashed bcrypt
  nama           String
  email          String?    @unique
  noHp           String?
  roles          UserRole[]
  nim            String? // Khusus Mahasiswa
  nidn           String? // Khusus Dosen
  fakultas       String?
  prodi          String?
  avatar         String?
  jenisKelamin   String?    @map("jenis_kelamin") @db.VarChar(20) // Laki-Laki / Perempuan
  tempatLahir    String?    @map("tempat_lahir") @db.VarChar(100)
  tanggalLahir   String?    @map("tanggal_lahir") @db.VarChar(30)
  nik            String?    @unique @db.VarChar(30)
  angkatan       String?    @db.VarChar(10)
  statusAkademik String?    @default("Aktif") @map("status_akademik") @db.VarChar(50)
  alamat         String?    @db.Text
  asalSekolah    String?    @map("asal_sekolah") @db.VarChar(150)
  namaIbuKandung String?    @map("nama_ibu_kandung") @db.VarChar(120)
  
  // Profil Akademik & Riset Dosen Tambahan
  gelarDepan        String?  @map("gelar_depan") @db.VarChar(50)
  gelarBelakang     String?  @map("gelar_belakang") @db.VarChar(50)
  nip               String?  @db.VarChar(50)
  jabatanAkademik   String?  @map("jabatan_akademik") @db.VarChar(100) // Asisten Ahli, Lektor, dll.
  bidangKeahlian    String?  @map("bidang_keahlian") @db.VarChar(255)
  pendidikanTerakhir String? @map("pendidikan_terakhir") @db.VarChar(50) // S2, S3, dll.
  sintaId           String?  @map("sinta_id") @db.VarChar(50)
  linkSinta         String?  @map("link_sinta") @db.VarChar(255)
  googleScholar     String?  @map("google_scholar") @db.VarChar(255)
  orcid             String?  @db.VarChar(50)
  scopusId          String?  @map("scopus_id") @db.VarChar(50)
  biografi          String?  @db.Text

  syncedAt       DateTime?  @map("synced_at")
  isActive       Boolean    @default(true)
  lastLoginAt    DateTime? // Diisi saat login sukses (audit & kebijakan akun dorman)
  /*
   * Penanda bahwa akun masih memakai kata sandi bawaan hasil provisioning
   * SIAKAD (`Unusu123!`). Selama nilainya `true`, portal menampilkan modal
   * ganti kata sandi yang tidak dapat ditutup. Dinonaktifkan otomatis saat
   * pengguna mengganti kata sandinya sendiri.
   */
  harusGantiPassword Boolean @default(false) @map("harus_ganti_password")
  passwordDiubahAt   DateTime? @map("password_diubah_at")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  authTokens SsoAuthToken[]
  auditLogs  AuditLog[]
  berkas     DosenBerkas[]

  // Login mencari OR(username, nim, nidn) -> nim & nidn butuh index sendiri.
  @@index([nim])
  @@index([nidn])
  // Dashboard admin memfilter akun aktif.
  @@index([isActive])
  // Filter daftar pengguna per program studi.
  @@index([prodi])
  @@map("users")
}

// 2. REGISTRY APLIKASI CABANG TERINTEGRASI SSO (Mirip developer_opd_app di SSO Medan)
model SsoApp {
  id          Int      @id @default(autoincrement())
  clientId    String   @unique // Identifier unik aplikasi (cth: "lms-unusu")
  clientKey   String // Secret key untuk validasi Server-to-Server
  nameApp     String // Nama aplikasi (cth: "LMS UNUSU - Ruang Belajar Online")
  description String?  @db.Text
  icon        String?  @db.LongText // Data URL gambar base64 atau nama ikon lama
  badge       String?  @default("Akademik")
  urlRedirect String // URL Callback di cabang (cth: "http://localhost:5174/sso/callback")
  targetRoles String // Role yang diizinkan (JSON: '["DOSEN","MAHASISWA"]')
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  // Penghitung kunjungan nyata: dinaikkan setiap kali tiket SSO diterbitkan
  // (lihat GET /api/sso/app-client/:clientId/v2/redirect). Dipakai dashboard
  // untuk menaruh aplikasi yang paling sering dibuka di urutan depan.
  hitCount    Int      @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authTokens SsoAuthToken[]
  apiKeys    ApiKey[]

  // Query portal: WHERE isActive = true ORDER BY `order` ASC
  @@index([isActive, order])
  // Query "paling sering dikunjungi": WHERE isActive = true ORDER BY hitCount DESC
  @@index([isActive, hitCount])
  @@map("sso_apps")
}

// 2. OTORISASI BERBASIS PERMISSION (resource:action)
// Contoh key: "profile:menu", "profile:view", "profile:edit", "profile:delete"
model Permission {
  id        Int              @id @default(autoincrement())
  key       String           @unique @db.VarChar(100)
  resource  String           @db.VarChar(50)
  action    String           @db.VarChar(20)
  label     String           @db.VarChar(120)
  createdAt DateTime         @default(now())
  roles     RolePermission[]

  // Matrix permission diurutkan ORDER BY resource ASC, action ASC
  @@index([resource, action])
  @@map("permissions")
}

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String?          @db.Text
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// 3. TOKEN OTENTIKASI SINGLE-USE (V2 Single-Use Token 64 Char)
model SsoAuthToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique @db.VarChar(64) // 64 char random string
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String
  appId     Int
  app       SsoApp    @relation(fields: [appId], references: [id], onDelete: Cascade)
  expiresAt DateTime // Waktu kedaluwarsa (5 menit)
  isUsed    Boolean   @default(false) // 0 = aktif, 1 = sudah dibakar/hangus
  usedAt    DateTime? // Jejak waktu token dibakar (forensik replay attack)
  requestIp String?   @db.VarChar(45) // IPv4/IPv6 penerbit token
  createdAt DateTime  @default(now())

  // Validasi token cabang: WHERE clientId = ? AND isUsed = false AND expiresAt > NOW()
  @@index([clientId, isUsed, expiresAt])
  // Riwayat SSO per user (halaman audit & investigasi insiden).
  @@index([userId, createdAt])
  // Job pembersihan token kedaluwarsa: WHERE expiresAt < ?
  @@index([expiresAt])
  // CATATAN: index lama (token, clientId) dipertahankan agar migrasi tetap
  // aditif. `token` sudah UNIQUE sehingga index lama bisa dihapus pada migrasi
  // terpisah setelah masa observasi (lihat rollback/cleanup plan di docs).
  @@index([token, clientId])
  @@map("sso_auth_tokens")
}

// 4. AUDIT LOG TERPUSAT (append-only) — dipakai lintas modul untuk tata kelola
//    dan pembuktian aktivitas administrator (SSO, role, user, konten).
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int? // NULL jika aksi sistem / anonim
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel String?  @db.VarChar(191) // Snapshot username agar tetap terbaca jika user dihapus
  action     String   @db.VarChar(60) // cth: "LOGIN_SUCCESS", "ROLE_UPDATE", "APP_DELETE"
  resource   String   @db.VarChar(60) // cth: "user", "sso_app", "role", "banner_slider"
  resourceId String?  @db.VarChar(64)
  status     String   @default("SUCCESS") @db.VarChar(20) // SUCCESS | DENIED | FAILED
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(255)
  metadata   Json? // Detail tambahan (field yang berubah, alasan, dsb.)
  createdAt  DateTime @default(now())

  // Feed audit terbaru: ORDER BY createdAt DESC LIMIT n
  @@index([createdAt])
  // "Apa saja yang dilakukan user X?" -> WHERE actorId = ? ORDER BY createdAt DESC
  @@index([actorId, createdAt])
  // "Riwayat perubahan objek Y" -> WHERE resource = ? AND resourceId = ?
  @@index([resource, resourceId])
  // Statistik & filter per jenis aksi.
  @@index([action, createdAt])
  @@map("audit_logs")
}

// Data Pendukung Landing / Master Publik Lama (Dipertahankan agar kompatibel jika ada modul butuh)
model Fakultas {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nama      String
  kode      String?
  dekan     String?
  deskripsi String?  @db.Text
  visi      String?  @db.Text
  misi      String?  @db.Text
  icon      String?  @default("GraduationCap")
  prodiList Prodi[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fakultas")
}

model Prodi {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  nama       String
  jenjang    String   @default("S1")
  akreditasi String?  @default("Baik")
  kaprodi    String?
  deskripsi  String?  @db.Text
  fakultasId Int
  fakultas   Fakultas @relation(fields: [fakultasId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("prodi")
}

model LayananKampus {
  id         Int      @id @default(autoincrement())
  nama       String
  kategori   String
  deskripsi  String?
  urlTarget  String
  icon       String?  @db.LongText
  isExternal Boolean  @default(false)
  urutan     Int      @default(0)
  active     Boolean  @default(true)
  // Penghitung kunjungan nyata: dinaikkan saat pengguna menekan "Kunjungi
  // Tautan" di dashboard. Dipakai untuk menaruh direktori terpopuler di depan.
  hitCount   Int      @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Portal publik: WHERE active = true ORDER BY urutan ASC
  @@index([active, urutan])
  // Query "paling sering dikunjungi": WHERE active = true ORDER BY hitCount DESC
  @@index([active, hitCount])
  // Tab/filter kategori layanan.
  @@index([kategori, active])
  @@map("layanan_kampus")
}

model Berita {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  judul       String
  ringkasan   String?  @db.Text
  konten      String   @db.LongText
  kategori    String   @default("Pengumuman")
  penulis     String?  @default("Humas UNUSU")
  gambar      String?
  views       Int      @default(0)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Arsip berita: ORDER BY publishedAt DESC LIMIT n
  @@index([publishedAt])
  // Daftar per kategori: WHERE kategori = ? ORDER BY publishedAt DESC
  @@index([kategori, publishedAt])
  @@map("berita")
}

model BannerSlider {
  id              Int      @id @default(autoincrement())
  judul           String
  subjudul        String?
  gambarUrl       String   @db.LongText
  gambarMobileUrl String?  @db.LongText
  linkUrl         String?
  urutan          Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // WHERE active = true ORDER BY urutan ASC
  @@index([active, urutan])
  @@map("banner_sliders")
}

// ========================================
// 5. BERKAS DOSEN (Document Management)
// Manajemen dokumen/berkas dosen (CV, Ijazah, SK, Sertifikat, dll)
// ========================================

model DosenBerkasTipe {
  id          Int       @id @default(autoincrement())
  kode        String    @unique @db.VarChar(50) // Contoh: "CV", "IJAZAH_S2_S3", "SK_DOSEN", etc
  nama        String    @db.VarChar(150) // Contoh: "CV", "Ijazah S2 / S3", "SK Dosen"
  deskripsi   String?   @db.Text
  urutan      Int       @default(0)
  isRequired  Boolean   @default(false) // Apakah berkas wajib diupload
  isActive    Boolean   @default(true)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  berkas      DosenBerkas[]
  
  @@index([isActive, urutan])
  @@map("dosen_berkas_tipe")
}

model DosenBerkas {
  id            Int       @id @default(autoincrement())
  
  // Referensi dosen & jenis berkas
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tipeId        Int
  tipe          DosenBerkasTipe @relation(fields: [tipeId], references: [id], onDelete: Cascade)
  
  // Metadata dokumen
  namaFile      String    @db.VarChar(255) // Nama dokumen (contoh: "CV Lengkap - 2026")
  nomorDokumen  String?   @db.VarChar(100) // Nomor dokumen (contoh: "SK-123/2026")
  tahunSK       String?   @db.VarChar(4) // Tahun SK (contoh: "2026")
  keterangan    String?   @db.Text // Catatan/deskripsi tambahan
  
  // File storage
  fileUrl       String    @db.Text // URL atau path simpan PDF (S3, local storage, etc)
  fileSize      Int // Ukuran file dalam bytes
  mimeType      String    @default("application/pdf") @db.VarChar(50)
  
  // Audit
  uploadedAt    DateTime  @default(now())
  uploadedBy    Int // User ID yang upload
  updatedAt     DateTime  @updatedAt
  
  // Status verifikasi (opsional untuk admin)
  isVerified    Boolean   @default(false)
  verifiedAt    DateTime?
  verifiedBy    Int? // User ID admin yang verifikasi
  verificationNote String? @db.Text
  
  // Soft delete (arsip tanpa menghapus)
  isArchived    Boolean   @default(false)
  archivedAt    DateTime?
  
  @@unique([userId, tipeId, uploadedAt]) // Hindari duplikat upload di hari sama
  @@index([userId, isArchived])
  @@index([tipeId, isVerified])
  @@index([uploadedAt])
  @@map("dosen_berkas")
}

// ========================================
// 5. INTER-SERVICE API GATEWAY & HUB
// Katalog endpoint lintas-aplikasi & otorisasi M2M (Machine-to-Machine)
// ========================================

model ApiEndpoint {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(150) // Contoh: "Data Induk Dosen & Homebase"
  description String?   @db.Text // Dokumentasi lengkap, parameter, contoh respon
  endpoint    String    @unique @db.VarChar(255) // Contoh: "/api/v1/inter-service/dosen"
  method      String    @db.VarChar(10) // GET, POST, PUT, DELETE, PATCH
  sourceApp   String    @db.VarChar(100) // Penyedia: "ONE_UNUSU", "LPPM", "SARPRAS", dll
  category    String    @default("data") @db.VarChar(50) // data, report, action, etc.
  
  // Contoh response JSON bawaan untuk dokumentasi & testing
  exampleRequest  String?   @db.Text // JSON stringify
  exampleResponse String?   @db.Text // JSON stringify
  
  isActive    Boolean   @default(true)
  isPublic    Boolean   @default(false) // Apakah semua app bisa akses atau perlu register dulu
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Index untuk pencarian & filter
  @@index([sourceApp, isActive])
  @@index([category, isActive])
  @@index([isPublic])
  @@map("api_endpoints")
}

model ApiKey {
  id            Int       @id @default(autoincrement())
  key           String    @unique @db.VarChar(255) // Format: "unusu_sec_" + random hash (40+ chars)
  name          String    @db.VarChar(150) // Contoh: "LPPM Service Token", "LMS Sync Token"
  description   String?   @db.Text
  
  // Aplikasi pemilik token (app mana yang boleh pakai token ini)
  appId         Int
  app           SsoApp    @relation(fields: [appId], references: [id], onDelete: Cascade)
  
  // Scope endpoint yang diizinkan (JSON array: ["endpoint_id_1", "endpoint_id_2"])
  // Jika kosong atau null = semua endpoint yang isPublic=true
  allowedEndpoints String?  @db.Text // JSON: [id1, id2, id3] atau null untuk public all
  
  // Audit trail
  isActive      Boolean   @default(true)
  revoked       Boolean   @default(false)
  revokedAt     DateTime?
  revokedReason String?   @db.VarChar(255)
  
  lastUsedAt    DateTime?
  lastUsedIp    String?   @db.VarChar(45)
  usageCount    Int       @default(0)
  
  createdAt     DateTime  @default(now())
  createdBy     Int? // User ID yang membuat token
  updatedAt     DateTime  @updatedAt
  
  // Relasi ke riwayat penggunaan
  usageLogs     ApiUsageLog[]
  
  // Index untuk pencarian & validasi
  @@index([appId, isActive])
  @@index([revoked])
  @@index([key]) // Validasi token cepat
  @@map("api_keys")
}

model ApiUsageLog {
  id        Int       @id @default(autoincrement())
  
  // Siapa yang memanggil
  keyId     Int
  key       ApiKey    @relation(fields: [keyId], references: [id], onDelete: Cascade)
  
  // Endpoint apa yang dipanggil
  endpoint  String    @db.VarChar(255)
  method    String    @db.VarChar(10)
  
  // Status & metadata respon
  statusCode Int
  responseTime Int     @default(0) // Milliseconds
  
  // Request info
  requestIp  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(255)
  
  // Error message jika gagal
  errorMessage String? @db.VarChar(500)
  
  createdAt  DateTime @default(now())
  
  // Query riwayat per aplikasi & endpoint
  @@index([keyId, createdAt])
  @@index([endpoint, createdAt])
  @@index([statusCode])
  @@map("api_usage_logs")
}

