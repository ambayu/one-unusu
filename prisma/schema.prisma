// Prisma schema for ONE UNUSU - Central SSO Identity Provider & Portal Gateway
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. MASTER PENGGUNA SSO
model User {
  id             Int        @id @default(autoincrement())
  username       String     @unique // NIM Mahasiswa / NIDN Dosen / Username Admin
  password       String // Hashed bcrypt
  nama           String
  email          String?    @unique
  noHp           String?
  roles          UserRole[]
  nim            String? // Khusus Mahasiswa
  nidn           String? // Khusus Dosen
  fakultas       String?
  prodi          String?
  avatar         String?
  jenisKelamin   String?    @map("jenis_kelamin") @db.VarChar(20) // Laki-Laki / Perempuan
  tempatLahir    String?    @map("tempat_lahir") @db.VarChar(100)
  tanggalLahir   String?    @map("tanggal_lahir") @db.VarChar(30)
  nik            String?    @unique @db.VarChar(30)
  angkatan       String?    @db.VarChar(10)
  statusAkademik String?    @default("Aktif") @map("status_akademik") @db.VarChar(50)
  alamat         String?    @db.Text
  asalSekolah    String?    @map("asal_sekolah") @db.VarChar(150)
  namaIbuKandung String?    @map("nama_ibu_kandung") @db.VarChar(120)
  syncedAt       DateTime?  @map("synced_at")
  isActive       Boolean    @default(true)
  lastLoginAt    DateTime? // Diisi saat login sukses (audit & kebijakan akun dorman)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  authTokens SsoAuthToken[]
  auditLogs  AuditLog[]

  // Login mencari OR(username, nim, nidn) -> nim & nidn butuh index sendiri.
  @@index([nim])
  @@index([nidn])
  // Dashboard admin memfilter akun aktif.
  @@index([isActive])
  // Filter daftar pengguna per program studi.
  @@index([prodi])
  @@map("users")
}

// 2. REGISTRY APLIKASI CABANG TERINTEGRASI SSO (Mirip developer_opd_app di SSO Medan)
model SsoApp {
  id          Int      @id @default(autoincrement())
  clientId    String   @unique // Identifier unik aplikasi (cth: "lms-unusu")
  clientKey   String // Secret key untuk validasi Server-to-Server
  nameApp     String // Nama aplikasi (cth: "LMS UNUSU - Ruang Belajar Online")
  description String?  @db.Text
  icon        String?  @db.LongText // Data URL gambar base64 atau nama ikon lama
  badge       String?  @default("Akademik")
  urlRedirect String // URL Callback di cabang (cth: "http://localhost:5174/sso/callback")
  targetRoles String // Role yang diizinkan (JSON: '["DOSEN","MAHASISWA"]')
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  // Penghitung kunjungan nyata: dinaikkan setiap kali tiket SSO diterbitkan
  // (lihat GET /api/sso/app-client/:clientId/v2/redirect). Dipakai dashboard
  // untuk menaruh aplikasi yang paling sering dibuka di urutan depan.
  hitCount    Int      @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authTokens SsoAuthToken[]

  // Query portal: WHERE isActive = true ORDER BY `order` ASC
  @@index([isActive, order])
  // Query "paling sering dikunjungi": WHERE isActive = true ORDER BY hitCount DESC
  @@index([isActive, hitCount])
  @@map("sso_apps")
}

// 2. OTORISASI BERBASIS PERMISSION (resource:action)
// Contoh key: "profile:menu", "profile:view", "profile:edit", "profile:delete"
model Permission {
  id        Int              @id @default(autoincrement())
  key       String           @unique @db.VarChar(100)
  resource  String           @db.VarChar(50)
  action    String           @db.VarChar(20)
  label     String           @db.VarChar(120)
  createdAt DateTime         @default(now())
  roles     RolePermission[]

  // Matrix permission diurutkan ORDER BY resource ASC, action ASC
  @@index([resource, action])
  @@map("permissions")
}

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String?          @db.Text
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// 3. TOKEN OTENTIKASI SINGLE-USE (V2 Single-Use Token 64 Char)
model SsoAuthToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique @db.VarChar(64) // 64 char random string
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String
  appId     Int
  app       SsoApp    @relation(fields: [appId], references: [id], onDelete: Cascade)
  expiresAt DateTime // Waktu kedaluwarsa (5 menit)
  isUsed    Boolean   @default(false) // 0 = aktif, 1 = sudah dibakar/hangus
  usedAt    DateTime? // Jejak waktu token dibakar (forensik replay attack)
  requestIp String?   @db.VarChar(45) // IPv4/IPv6 penerbit token
  createdAt DateTime  @default(now())

  // Validasi token cabang: WHERE clientId = ? AND isUsed = false AND expiresAt > NOW()
  @@index([clientId, isUsed, expiresAt])
  // Riwayat SSO per user (halaman audit & investigasi insiden).
  @@index([userId, createdAt])
  // Job pembersihan token kedaluwarsa: WHERE expiresAt < ?
  @@index([expiresAt])
  // CATATAN: index lama (token, clientId) dipertahankan agar migrasi tetap
  // aditif. `token` sudah UNIQUE sehingga index lama bisa dihapus pada migrasi
  // terpisah setelah masa observasi (lihat rollback/cleanup plan di docs).
  @@index([token, clientId])
  @@map("sso_auth_tokens")
}

// 4. AUDIT LOG TERPUSAT (append-only) — dipakai lintas modul untuk tata kelola
//    dan pembuktian aktivitas administrator (SSO, role, user, konten).
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int? // NULL jika aksi sistem / anonim
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel String?  @db.VarChar(191) // Snapshot username agar tetap terbaca jika user dihapus
  action     String   @db.VarChar(60) // cth: "LOGIN_SUCCESS", "ROLE_UPDATE", "APP_DELETE"
  resource   String   @db.VarChar(60) // cth: "user", "sso_app", "role", "banner_slider"
  resourceId String?  @db.VarChar(64)
  status     String   @default("SUCCESS") @db.VarChar(20) // SUCCESS | DENIED | FAILED
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(255)
  metadata   Json? // Detail tambahan (field yang berubah, alasan, dsb.)
  createdAt  DateTime @default(now())

  // Feed audit terbaru: ORDER BY createdAt DESC LIMIT n
  @@index([createdAt])
  // "Apa saja yang dilakukan user X?" -> WHERE actorId = ? ORDER BY createdAt DESC
  @@index([actorId, createdAt])
  // "Riwayat perubahan objek Y" -> WHERE resource = ? AND resourceId = ?
  @@index([resource, resourceId])
  // Statistik & filter per jenis aksi.
  @@index([action, createdAt])
  @@map("audit_logs")
}

// Data Pendukung Landing / Master Publik Lama (Dipertahankan agar kompatibel jika ada modul butuh)
model Fakultas {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nama      String
  kode      String?
  dekan     String?
  deskripsi String?  @db.Text
  visi      String?  @db.Text
  misi      String?  @db.Text
  icon      String?  @default("GraduationCap")
  prodiList Prodi[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fakultas")
}

model Prodi {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  nama       String
  jenjang    String   @default("S1")
  akreditasi String?  @default("Baik")
  kaprodi    String?
  deskripsi  String?  @db.Text
  fakultasId Int
  fakultas   Fakultas @relation(fields: [fakultasId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("prodi")
}

model LayananKampus {
  id         Int      @id @default(autoincrement())
  nama       String
  kategori   String
  deskripsi  String?
  urlTarget  String
  icon       String?  @db.LongText
  isExternal Boolean  @default(false)
  urutan     Int      @default(0)
  active     Boolean  @default(true)
  // Penghitung kunjungan nyata: dinaikkan saat pengguna menekan "Kunjungi
  // Tautan" di dashboard. Dipakai untuk menaruh direktori terpopuler di depan.
  hitCount   Int      @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Portal publik: WHERE active = true ORDER BY urutan ASC
  @@index([active, urutan])
  // Query "paling sering dikunjungi": WHERE active = true ORDER BY hitCount DESC
  @@index([active, hitCount])
  // Tab/filter kategori layanan.
  @@index([kategori, active])
  @@map("layanan_kampus")
}

model Berita {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  judul       String
  ringkasan   String?  @db.Text
  konten      String   @db.LongText
  kategori    String   @default("Pengumuman")
  penulis     String?  @default("Humas UNUSU")
  gambar      String?
  views       Int      @default(0)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Arsip berita: ORDER BY publishedAt DESC LIMIT n
  @@index([publishedAt])
  // Daftar per kategori: WHERE kategori = ? ORDER BY publishedAt DESC
  @@index([kategori, publishedAt])
  @@map("berita")
}

model BannerSlider {
  id              Int      @id @default(autoincrement())
  judul           String
  subjudul        String?
  gambarUrl       String   @db.LongText
  gambarMobileUrl String?  @db.LongText
  linkUrl         String?
  urutan          Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // WHERE active = true ORDER BY urutan ASC
  @@index([active, urutan])
  @@map("banner_sliders")
}
